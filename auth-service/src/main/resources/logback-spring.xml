<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Set the logging level globally -->
    <property name="LOG_LEVEL" value="DEBUG"/>

    <!-- Define log file path -->
    <property name="LOG_PATH" value="logs"/>

    <!-- Console appender for displaying logs in the console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for writing logs to a file -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/auth_service.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger configuration -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Logger configuration for specific packages or classes -->
    <logger name="com.example" level="INFO"/>
</configuration>
